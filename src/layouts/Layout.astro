---
import "../styles/global.css";

const API_URL: string = import.meta.env.PUBLIC_API_URL || "https://tienda-backend-production-9f16.up.railway.app";

let nombreTienda: string = "Mi Tienda";
let logoUrl: string | null = null;
let imagenesCategorias: string[] = [];

try {
  const [resConfig, resCategorias] = await Promise.all([
    fetch(`${API_URL}/api/configuracion`),
    fetch(`${API_URL}/api/categorias?populate=*`)
  ]);

  if (resConfig.ok) {
    const data = await resConfig.json();
    nombreTienda = data?.data?.nombre_tienda || "Mi Tienda";
    logoUrl = data?.data?.logo?.url || null;
  }

  if (resCategorias.ok) {
    const data = await resCategorias.json();
    imagenesCategorias = (data.data || [])
      .map((cat: any) => cat.imagen?.url || cat.imagen?.data?.attributes?.url)
      .filter((url: unknown): url is string => typeof url === 'string');
  }
} catch (error) {
  console.error("Error al cargar datos del header:", error);
}

const { title = nombreTienda } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tienda online sencilla y rápida" />
    <title>{nombreTienda}</title>
    <slot name="head" />
  </head>

  <body>
    <!-- 🔝 HEADER REDISEÑADO -->
    <header class="header" id="main-header">
      <!-- 🖼️ Collage de fondo -->
      <div class="header-bg">
        {imagenesCategorias.length > 0
          ? imagenesCategorias.map((url: string) => (
              <img
                src={url.startsWith('http') ? url : `${API_URL}${url}`}
                alt=""
              />
            ))
          : null}
      </div>

      <div class="header-inner">
        <!-- 🏪 Logo + Nombre (clickeable para info) -->
        <div class="header-left" id="btn-info-tienda">
          {logoUrl ? (
            <img
              src={logoUrl.startsWith('http') ? logoUrl : `${API_URL}${logoUrl}`}
              alt={nombreTienda}
              class="header-logo"
            />
          ) : (
            <div
              class="header-logo"
              style="background:#2ecc71;display:flex;align-items:center;justify-content:center;font-size:1.5rem;"
            >
              🛒
            </div>
          )}
          <div class="header-info">
            <h2 class="header-name">{nombreTienda}</h2>
            <p class="header-tagline">Tu tienda de confianza</p>
          </div>
        </div>

        <!-- 📦 Quiénes Somos + Carrito -->
        <div class="header-right">
          <button class="btn-quienes-somos" id="btn-quienes-somos">
            📖 Quiénes Somos
          </button>
          <button class="btn-cart-header" id="btn-cart-header">
            🛒
            <span
              class="cart-badge-header"
              id="cart-badge-header"
              style="display:none"
            >
              0
            </span>
          </button>
        </div>
      </div>
    </header>

    <!-- 📖 MODAL QUIÉNES SOMOS -->
    <div class="modal-overlay" id="modal-quienes-somos" style="display:none">
      <div class="modal-content">
        <button class="modal-close" id="modal-close">✕</button>
        <h3 class="modal-title" id="modal-title">Quiénes Somos</h3>
        <div class="modal-body" id="modal-body">
          Cargando...
        </div>
      </div>
    </div>

    <!-- 📦 CONTENIDO PRINCIPAL -->
    <main class="container">
      <slot />
    </main>
  </body>
</html>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || "https://tienda-backend-production-9f16.up.railway.app";

  interface InfoTienda {
    descripcion: string;
    direccion: string;
    telefono: string;
    email: string;
  }

  async function cargarInfoTienda(): Promise<InfoTienda | null> {
    try {
      const res = await fetch(`${API_URL}/api/configuracion`);
      if (res.ok) {
        const data = await res.json();
        const config = data?.data || {};
        return {
          descripcion: config.descripcion_tienda || config.quienes_somos || 'Información no disponible.',
          direccion: config.direccion || 'No especificada',
          telefono: config.telefono || config.telefono_whatsapp || 'No especificado',
          email: config.email || 'No especificado',
        };
      }
    } catch (e) {
      console.error('Error cargando info:', e);
    }
    return null;
  }

  function abrirModal(info: InfoTienda | null): void {
    const modal = document.getElementById('modal-quienes-somos');
    const body = document.getElementById('modal-body');
    const title = document.getElementById('modal-title');

    if (!modal || !body || !title) return;

    if (info) {
      title.textContent = 'Quiénes Somos';
      body.innerHTML = `
        <p>${info.descripcion}</p>
        <div class="modal-contacto">
          <p><strong>📍 Dirección:</strong> ${info.direccion}</p>
          <p><strong>📞 Teléfono:</strong> ${info.telefono}</p>
          <p><strong>✉️ Email:</strong> ${info.email}</p>
        </div>
      `;
    } else {
      body.textContent = 'No se pudo cargar la información.';
    }
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function cerrarModal(): void {
    const modal = document.getElementById('modal-quienes-somos');
    if (modal) {
      modal.style.display = 'none';
    }
    document.body.style.overflow = '';
  }

  const btnQuienesSomos = document.getElementById('btn-quienes-somos');
  const btnInfoTienda = document.getElementById('btn-info-tienda');
  const modalClose = document.getElementById('modal-close');
  const modalOverlay = document.getElementById('modal-quienes-somos');
  const btnCartHeader = document.getElementById('btn-cart-header');

  if (btnQuienesSomos) {
    btnQuienesSomos.addEventListener('click', async () => {
      const info = await cargarInfoTienda();
      abrirModal(info);
    });
  }

  if (btnInfoTienda) {
    btnInfoTienda.addEventListener('click', async () => {
      const info = await cargarInfoTienda();
      abrirModal(info);
    });
  }

  if (modalClose) {
    modalClose.addEventListener('click', cerrarModal);
  }

  if (modalOverlay) {
    modalOverlay.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) cerrarModal();
    });
  }

  function actualizarBadge(): void {
    const cartData = localStorage.getItem('cart');
    const cart = cartData ? JSON.parse(cartData) : [];
    const total: number = cart.reduce(
      (sum: number, item: { quantity?: number }) => sum + (item.quantity || 1),
      0
    );
    const badge = document.getElementById('cart-badge-header');
    if (!badge) return;
    if (total > 0) {
      badge.textContent = String(total);
      badge.style.display = 'flex';
    } else {
      badge.style.display = 'none';
    }
  }

  if (btnCartHeader) {
    btnCartHeader.addEventListener('click', () => {
      const fab = document.querySelector('.cart-fab');
      if (fab && fab instanceof HTMLElement) {
        fab.click();
      }
    });
  }

  actualizarBadge();
  window.addEventListener('cartUpdated', actualizarBadge);
  window.addEventListener('storage', actualizarBadge);
</script>