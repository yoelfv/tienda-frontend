---
import "../styles/global.css";

const API_URL: string = import.meta.env.PUBLIC_API_URL || "https://tienda-backend-production-9f16.up.railway.app";

let nombreTienda: string = "Mi Tienda";
let logoUrl: string | null = null;
let imagenesCategorias: string[] = [];

function extraerUrlImagen(imagen: any): string | null {
  if (!imagen) return null;
  if (typeof imagen === 'string') return imagen;
  if (imagen.url) return imagen.url;
  if (imagen.data?.attributes?.url) return imagen.data.attributes.url;
  return null;
}

try {
  const [resConfig, resCategorias] = await Promise.all([
    fetch(`${API_URL}/api/configuracion?populate=*`),
    fetch(`${API_URL}/api/categorias?populate=*`)
  ]);

  if (resConfig.ok) {
    const configData = await resConfig.json();
    const config = configData?.data || configData || {};
    nombreTienda = config.nombre_tienda || "Mi Tienda";
    logoUrl = extraerUrlImagen(config.logo);
  }

  if (resCategorias.ok) {
    const catData = await resCategorias.json();
    const categorias = catData?.data || [];

    if (Array.isArray(categorias)) {
      imagenesCategorias = categorias
        .map((cat: any) => extraerUrlImagen(cat.imagen))
        .filter((url: unknown): url is string => typeof url === 'string');
    }
  }
} catch (error) {
  console.error("Error al cargar datos del header:", error);
}

const { title = nombreTienda } = Astro.props;

// Duplicar imágenes para el carrusel infinito
const imagenesDuplicadas = [...imagenesCategorias, ...imagenesCategorias];

// Optimizar la imagen del logo
const optimizeImage = (url: string, width: number = 100): string => {
  if (!url) return "";

  if (url.includes("/upload/")) {
    return url.replace("/upload/", `/upload/f_auto,q_auto,w_${width}/`);
  }

  return url;
};

const finalLogo = logoUrl
  ? optimizeImage(
      logoUrl.startsWith("http") ? logoUrl : `${API_URL}${logoUrl}`,
      100
    )
  : "";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tienda online sencilla y rápida" />
    <title>{nombreTienda}</title>
    <slot name="head" />
  </head>

  <body>
    <header class="header" id="main-header">
      <!-- 🎠 CARRUSEL DE FONDO -->
      {imagenesCategorias.length > 0 ? (
        <div class="header-bg">
          <div class="header-bg-track">
            {imagenesDuplicadas.map((url: string) => (
              <img
                src={url.startsWith('http') ? url : `${API_URL}${url}`}
                alt=""
                loading="lazy"
              />
            ))}
          </div>
        </div>
      ) : null}

      <div class="header-inner">
        <div class="header-left" id="btn-info-tienda">
          {logoUrl ? (
            <img
              src={finalLogo}
              alt={nombreTienda}
              class="header-logo"
              loading="eager"
            />
          ) : (
            <div
              class="header-logo"
              style="background:#2ecc71;display:flex;align-items:center;justify-content:center;font-size:1.5rem;"
            >
              🛒
            </div>
          )}
          <div class="header-info">
            <h2 class="header-name">{nombreTienda}</h2>
            <p class="header-tagline">Tu tienda de confianza</p>
          </div>
        </div>

        <div class="header-right">
          <button class="btn-quienes-somos" id="btn-quienes-somos">
            📖 Quiénes Somos
          </button>
        </div>
      </div>
    </header>

    <!-- 📖 MODAL QUIÉNES SOMOS -->
    <div class="modal-overlay" id="modal-quienes-somos" style="display:none">
      <div class="modal-content">
        <button class="modal-close" id="modal-close">✕</button>
        <h3 class="modal-title" id="modal-title">Quiénes Somos</h3>
        <div class="modal-body" id="modal-body">Cargando...</div>
      </div>
    </div>

    <!-- 📦 CONTENIDO PRINCIPAL -->
    <main class="container">
      <slot />
    </main>
  </body>
</html>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || "https://tienda-backend-production-9f16.up.railway.app";

  interface InfoTienda {
    descripcion: string;
    direccion: string;
    telefono: string;
    email: string;
  }

  function richTextToPlainText(blocks: any[]): string {
    if (!blocks || !Array.isArray(blocks)) return 'Información no disponible.';
    return blocks
      .map((block: any) => {
        if (block.children && Array.isArray(block.children)) {
          return block.children.map((child: any) => child.text || '').join('');
        }
        return '';
      })
      .filter((text: string) => text.trim() !== '')
      .join('\n');
  }

  async function cargarInfoTienda(): Promise<InfoTienda | null> {
    try {
      const res = await fetch(`${API_URL}/api/configuracion?populate=*`);
      if (res.ok) {
        const data = await res.json();
        const config = data?.data || {};
        let descripcion = 'Información no disponible.';
        if (config.descripcion_tienda) {
          if (typeof config.descripcion_tienda === 'string') {
            descripcion = config.descripcion_tienda;
          } else if (Array.isArray(config.descripcion_tienda)) {
            descripcion = richTextToPlainText(config.descripcion_tienda);
          }
        }
        return {
          descripcion,
          direccion: config.direccion || 'No especificada',
          telefono: config.telefono || config.telefono_whatsapp || 'No especificado',
          email: config.email || 'No especificado',
        };
      }
    } catch (e) {
      console.error('Error cargando info:', e);
    }
    return null;
  }

  function abrirModal(info: InfoTienda | null): void {
    const modal = document.getElementById('modal-quienes-somos');
    const body = document.getElementById('modal-body');
    const title = document.getElementById('modal-title');
    if (!modal || !body || !title) return;
    if (info) {
      title.textContent = 'Quiénes Somos';
      const descripcionHTML = info.descripcion.replace(/\n/g, '<br>');
      body.innerHTML = `
        <p>${descripcionHTML}</p>
        <div class="modal-contacto">
          <p><strong>📍 Dirección:</strong> ${info.direccion}</p>
          <p><strong>📞 Teléfono:</strong> ${info.telefono}</p>
          <p><strong>✉️ Email:</strong> ${info.email}</p>
        </div>
      `;
    } else {
      body.textContent = 'No se pudo cargar la información.';
    }
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function cerrarModal(): void {
    const modal = document.getElementById('modal-quienes-somos');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  document.getElementById('btn-quienes-somos')?.addEventListener('click', async () => {
    abrirModal(await cargarInfoTienda());
  });

  document.getElementById('btn-info-tienda')?.addEventListener('click', async () => {
    abrirModal(await cargarInfoTienda());
  });

  document.getElementById('modal-close')?.addEventListener('click', cerrarModal);

  document.getElementById('modal-quienes-somos')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) cerrarModal();
  });
</script>