---
import "../styles/global.css";
import CartCount from "../components/CartCount.jsx";

// Obtener el nombre de la tienda desde Strapi
const API_URL = import.meta.env.PUBLIC_API_URL || "https://tienda-backend-production-9f16.up.railway.app";

let nombreTienda = "Mi Tienda";

try {
  const res = await fetch(`${API_URL}/api/configuracion`);
  if (res.ok) {
    const data = await res.json();
    nombreTienda = data?.data?.nombre_tienda || "Mi Tienda";
  }
} catch (error) {
  console.error("Error al cargar nombre de tienda:", error);
}

const { title = nombreTienda } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <!-- 📱 Responsive -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 🧠 SEO básico -->
    <meta name="description" content="Tienda online sencilla y rápida" />

    <title>{nombreTienda}</title>
    <slot name="head" />
  </head>

  <body>

    <!-- 🔝 HEADER -->
    <header class="header">
      <div class="header-inner">
        <h2>🛒 {nombreTienda}</h2>
        <CartCount client:load />
      </div>
    </header>

    <!-- 📦 CONTENIDO -->
    <main class="container">
      <slot />
    </main>

  </body>
</html>