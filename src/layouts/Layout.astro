---
import "@/styles/global.css";
import { getApiUrl, parseRichText } from "@/utils/strapi-core";
import { getStrapiMediaOrNull, optimizeCloudinary } from "@/utils/strapi-media";

// ============================================
// 🔧 CONFIG DE LA TIENDA (build time)
// ============================================

interface ConfigTienda {
  nombre_tienda?: string;
  logo?: unknown;
  descripcion_tienda?: unknown;
  direccion?: string;
  telefono?: string;
  telefono_whatsapp?: string;
  email?: string;
}

let nombreTienda = "Cubaclick";
let logoUrl: string | null = null;
let config: ConfigTienda = {};

try {
  const resConfig = await fetch(`${getApiUrl()}/configuracion?populate=*`);

  if (resConfig.ok) {
    const configData = await resConfig.json();
    const raw: ConfigTienda = configData?.data ?? configData ?? {};

    config = raw;
    nombreTienda = raw.nombre_tienda || "Cubaclick";
    logoUrl = getStrapiMediaOrNull(raw.logo);
  } else {
    console.warn(
      `[Layout] No se pudo cargar /configuracion (status ${resConfig.status}). Usando valores por defecto.`
    );
  }
} catch (error) {
  console.error("[Layout] Error al cargar datos del header:", error);
}

// El logo se optimiza solo si existe. Si no hay logo, `finalLogo` queda en null
// y el template renderiza el emoji 🛒 en su lugar.
const finalLogo = logoUrl ? optimizeCloudinary(logoUrl, 100) : null;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tienda online sencilla y rápida" />
    <title>{nombreTienda}</title>
    <slot name="head" />
  </head>

  <body>
    <header class="header" id="main-header">
      <div class="header-inner">
        <div class="header-left" id="btn-info-tienda">
          {
            finalLogo ? (
              <img src={finalLogo} alt={nombreTienda} class="header-logo" loading="eager" />
            ) : (
              <div
                class="header-logo"
                style="background:#2ecc71;display:flex;align-items:center;justify-content:center;font-size:1.5rem;"
              >
                🛒
              </div>
            )
          }
          <div class="header-info">
            <h2 class="header-name">{nombreTienda}</h2>
            <p class="header-tagline">Tu tienda de confianza</p>
          </div>
        </div>

        <div class="header-right">
          <button class="btn-about-us" id="btn-about-us"> 📖 Quiénes Somos </button>
        </div>
      </div>
    </header>

    <!-- 📖 MODAL QUIÉNES SOMOS -->
    <div class="modal-overlay" id="modal-quienes-somos" style="display:none">
      <div class="modal-content">
        <button class="modal-close" id="modal-close">✕</button>
        <h3 class="modal-title" id="modal-title">Quiénes Somos</h3>
        <div class="modal-body" id="modal-body">Cargando...</div>
      </div>
    </div>

    <!-- 📦 CONTENIDO PRINCIPAL -->
    <main class="container">
      <slot />
    </main>
  </body>
</html>

<script>
  import { getApiUrl, parseRichText } from "@/utils/strapi-core";

  interface InfoTienda {
    descripcion: string;
    direccion: string;
    telefono: string;
    email: string;
  }

  async function cargarInfoTienda(): Promise<InfoTienda | null> {
    try {
      const res = await fetch(`${getApiUrl()}/configuracion?populate=*`);
      if (!res.ok) return null;

      const data = await res.json();
      const config = data?.data ?? {};

      let descripcion = "Información no disponible.";
      if (typeof config.descripcion_tienda === "string") {
        descripcion = config.descripcion_tienda;
      } else if (Array.isArray(config.descripcion_tienda)) {
        descripcion = parseRichText(config.descripcion_tienda);
      }

      return {
        descripcion,
        direccion: config.direccion || "No especificada",
        telefono: config.telefono || config.telefono_whatsapp || "No especificado",
        email: config.email || "No especificado",
      };
    } catch (e) {
      console.error("Error cargando info:", e);
      return null;
    }
  }

  function abrirModal(info: InfoTienda | null): void {
    const modal = document.getElementById("modal-quienes-somos");
    const body = document.getElementById("modal-body");
    const title = document.getElementById("modal-title");
    if (!modal || !body || !title) return;

    if (info) {
      title.textContent = "Quiénes Somos";
      const descripcionHTML = info.descripcion.replace(/\n/g, "<br>");
      body.innerHTML = `
        <p>${descripcionHTML}</p>
        <div class="modal-contact">
          <p><strong>📍 Dirección:</strong> ${info.direccion}</p>
          <p><strong>📞 Teléfono:</strong> ${info.telefono}</p>
          <p><strong>✉️ Email:</strong> ${info.email}</p>
        </div>
      `;
    } else {
      body.textContent = "No se pudo cargar la información.";
    }

    modal.style.display = "flex";
    document.body.style.overflow = "hidden";
  }

  function cerrarModal(): void {
    const modal = document.getElementById("modal-quienes-somos");
    if (modal) modal.style.display = "none";
    document.body.style.overflow = "";
  }

  document.getElementById("btn-about-us")?.addEventListener("click", async () => {
    abrirModal(await cargarInfoTienda());
  });

  document.getElementById("btn-info-tienda")?.addEventListener("click", async () => {
    abrirModal(await cargarInfoTienda());
  });

  document.getElementById("modal-close")?.addEventListener("click", cerrarModal);

  document.getElementById("modal-quienes-somos")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) cerrarModal();
  });

  const header = document.getElementById("main-header");

  window.addEventListener("scroll", () => {
    if (!header) return;
    header.classList.toggle("scrolled", window.scrollY > 20);
  });
</script>
