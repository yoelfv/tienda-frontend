---
import "../styles/global.css";

const API_URL = import.meta.env.PUBLIC_API_URL || "https://tienda-backend-production-9f16.up.railway.app";

let nombreTienda = "Mi Tienda";

try {
  const res = await fetch(`${API_URL}/api/configuracion`);
  if (res.ok) {
    const data = await res.json();
    nombreTienda = data?.data?.nombre_tienda || "Mi Tienda";
  }
} catch (error) {
  console.error("Error al cargar nombre de tienda:", error);
}

const { title = nombreTienda } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tienda online sencilla y rápida" />
    <title>{nombreTienda}</title>
    <slot name="head" />
  </head>

  <body>
    <!-- 🔝 HEADER + BARRA (contenedor sticky unificado) -->
    <div class="top-bar">
      <header class="header">
        <div class="header-inner">
          <a href="/" class="logo-link">
            <h2>🛒 {nombreTienda}</h2>
          </a>
        </div>
      </header>
      <!-- La barra de categorías se inserta desde el componente -->
    </div>

    <!-- 📦 CONTENIDO PRINCIPAL -->
    <main class="container">
      <slot />
    </main>
  </body>
</html>