---
import "../styles/global.css";
import CartCount from "../components/CartCount.jsx";
const { title = "Mi Tienda" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <!-- 📱 Responsive -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 🧠 SEO básico -->
    <meta name="description" content="Tienda online sencilla y rápida" />

    <title>{title}</title>
    <slot name="head" />

    <style>
      body {
              background: red !important;
            }
</style>
  </head>

  <body>

    <!-- 🔝 HEADER -->
    <header class="header">
      <div class="header-inner">
        <a href="/" class="logo">🛒 Mi Tienda</a>

        <nav>
          <CartCount client:load />
        </nav>
      </div>
    </header>

    <!-- 📦 CONTENIDO -->
    <main class="container">
      <slot />
    </main>

  </body>
</html>