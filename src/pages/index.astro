---
import Layout from "../layouts/Layout.astro";
import { getProductos, getStrapiMedia } from "../services/api";
import AddToCart from "../components/AddToCart.jsx";
import Cart from "../components/Cart.jsx";
import SafeImage from "../components/SafeImage.jsx";

const productos: Producto[] = await getProductos();

// 💰 formateo
const formatPrice = (v) => new Intl.NumberFormat("es-ES").format(v);
---

<Layout title="Tienda">
  <h1>Productos</h1>

  <Cart client:load />

  <!-- 🟢 BOTÓN STICKY -->
  <div class="sticky-checkout">
    <a href="/checkout" class="btn-sticky">
      🛒 Finalizar compra ahora
    </a>
  </div>

  <!-- 🧱 GRID -->
  <div class="productos-grid">
    {(productos || []).map(p => (
      <div class="card">

        <SafeImage
          src={getStrapiMedia(p.imagen?.url)}
          alt={p.nombre}
          className="product-img"
        />

        <div class="card-body">
          <h3>{p.nombre}</h3>
          <p class="precio">${formatPrice(p.precio)}</p>

          <AddToCart client:load product={p} />
        </div>

      </div>
    ))}
  </div>
</Layout>